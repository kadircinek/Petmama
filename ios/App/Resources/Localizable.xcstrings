    "Şimdilik dernek aylık toplamı paylaşıyor; sayaç bu toplamla güncellenir. Teslim fotoğrafları ve bildirimler v1.1'de geliyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik dernek aylık toplamı paylaşıyor; sayaç bu toplamla güncellenir. Teslim fotoğrafları ve bildirimler v1.1'de geliyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now the association shares a monthly total; the counter updates with that total. Delivery photos and notifications are coming in v1.1."
          }
        }
      }
    },
