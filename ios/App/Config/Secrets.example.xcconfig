// Bu dosyayı `Secrets.xcconfig` adıyla kopyalayın (git'e girmez).
// xcconfig'de "//" yorum başlattığı için URL'lerde `$()` hilesi kullanılır: https:/$()/...

MAMA_SUPABASE_URL = https:/$()/<proje-ref>.supabase.co
MAMA_SUPABASE_ANON_KEY = <publishable-veya-anon-key>
MAMA_DONATION_URL = https:/$()/ornek-dernek.org/bagis
MAMA_PARTNER_NAME = Örnek Hayvan Hakları Derneği
MAMA_USD_TRY_RATE = 41.5
