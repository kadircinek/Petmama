      }
    },
    "Yakınında kayıtlı kedi evi yok. İlkini sen ekleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında kayıtlı kedi evi yok. İlkini sen ekleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no registered cat house near you. You can add the first one."
          }
        }
      }
    },
    "Yakınında kayıtlı nokta bulamadık. Haritada noktayı açıp oradan da ihtiyaç bildirebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında kayıtlı nokta bulamadık. Haritada noktayı açıp oradan da ihtiyaç bildirebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find a registered spot near you. You can open a spot on the map and report a need from there."
          }
        }
      }
    },
    "Yakınında kayıtlı nokta bulamadık. Hayvanı noktasız da ekleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında kayıtlı nokta bulamadık. Hayvanı noktasız da ekleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find a registered spot near you. You can add the animal without a spot."
          }
        }
      }
    },
    "Yakınında kayıtlı nokta bulamadık. Nokta bağlamadan da paylaşabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında kayıtlı nokta bulamadık. Nokta bağlamadan da paylaşabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find a spot near you. You can also post without linking one."
          }
        }
      }
    },
    "Yakınında mama bekleyen bir nokta olduğunda veya takip ettiğin noktada bir şey değiştiğinde burada göreceksin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında mama bekleyen bir nokta olduğunda veya takip ettiğin noktada bir şey değiştiğinde burada göreceksin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see it here when a spot near you is waiting for food or something changes at a spot you follow."
          }
        }
      }
    },
    "Yakınında mama bekleyen hayvanlardan haberdar ol": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında mama bekleyen hayvanlardan haberdar ol"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay informed about animals waiting for food near you"
          }
        }
      }
    },
    "Yakınında mama gereken noktalar": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında mama gereken noktalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spots near you that need food"
          }
        }
      }
    },
    "Yakınında ya da koruyucusu olduğun bir nokta bulamadık. Haritadan noktanı açıp oradan da “Yerime bakar mısın?” diyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında ya da koruyucusu olduğun bir nokta bulamadık. Haritadan noktanı açıp oradan da “Yerime bakar mısın?” diyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find a spot nearby or one you're guardian of. You can also open your spot on the map and ask “Can you cover for me?” from there."
          }
        }
      }
    },
    "Yakınında şu an mama bekleyen nokta yok. Harika!": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında şu an mama bekleyen nokta yok. Harika!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spots near you are waiting for food right now. Great!"
          }
        }
      }
    },
    "Yakınındaki bir kap boşaldığında veya takip ettiğin noktada bir şey değiştiğinde haber verelim.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınındaki bir kap boşaldığında veya takip ettiğin noktada bir şey değiştiğinde haber verelim."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know when a bowl near you runs empty or something changes at a spot you follow."
          }
        }
      }
    },
    "Yakınındaki noktasını işaretleriz; konumun kaydedilmez.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınındaki noktasını işaretleriz; konumun kaydedilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We mark the spot near you; your location isn't stored."
          }
        }
      }
    },
    "Yalnızca uygulamayı kullanırken; arka planda konum istemeyiz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulamayı kullanırken; arka planda konum istemeyiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while using the app; we don't ask for background location."
          }
        }
      }
    },
    "Yalnızca yakındaki bildirimler açıksa: yaklaşık 110 m'ye yuvarlanmış tek bir değer, her güncellemede üzerine yazılır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
