{
  "sourceLanguage": "tr",
  "version": "1.0",
  "strings": {
    "\"Mama koydum\" dediğinde yalnızca noktaya olan uzaklık (metre) kaydedilir. Konum geçmişini asla saklamayız.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Mama koydum\" dediğinde yalnızca noktaya olan uzaklık (metre) kaydedilir. Konum geçmişini asla saklamayız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you tap \"I fed them\", we only record your distance to the spot (in meters). We never store your location history."
          }
        }
      }
    },
    "\"Tümü\" sekmesinden hepsini görebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
