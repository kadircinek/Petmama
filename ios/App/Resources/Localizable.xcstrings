            "state": "translated",
            "value": "Beslediğin noktayı komşularına anlat, birlikte sahiplenin. Sorun çıkarsa yeri birlikte değiştirmek kolaylaşır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell your neighbors about the spot you feed and look after it together. If a problem comes up, it's easier to move the spot together."
          }
        }
      }
    },
