        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the spots you feed and the animals you love, and their updates will show up here."
          }
        }
      }
    },
    "Beslediğin noktayı komşularına anlat, birlikte sahiplenin. Sorun çıkarsa yeri birlikte değiştirmek kolaylaşır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
