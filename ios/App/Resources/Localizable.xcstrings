    "Apartman ve dükkân giriş kapılarının önüne koyma.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apartman ve dükkân giriş kapılarının önüne koyma."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put food in front of building or shop entrances."
          }
        }
      }
    },
    "Apartman ve dükkân girişlerinin önü yerine ağaç dibi, bahçe kenarı gibi sakin köşeleri seç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apartman ve dükkân girişlerinin önü yerine ağaç dibi, bahçe kenarı gibi sakin köşeleri seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of building and shop entrances, pick quiet corners like the base of a tree or the edge of a garden."
          }
        }
      }
    },
