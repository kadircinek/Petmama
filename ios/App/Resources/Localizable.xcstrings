        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce a friend from the street"
          }
        }
      }
    },
    "Sokaktaki dostlarımızı beslerken komşularımızla da iyi geçinmek, beslemenin sürmesini sağlar. Birkaç küçük alışkanlık büyük fark yaratır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sokaktaki dostlarımızı beslerken komşularımızla da iyi geçinmek, beslemenin sürmesini sağlar. Birkaç küçük alışkanlık büyük fark yaratır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting along with our neighbors while feeding our friends on the street keeps the feeding going. A few small habits make a big difference."
          }
        }
      }
    },
    "Son": {
      "extractionState": "manual",
      "localizations": {
