    "Acil bir durum varsa önce 112'yi veya Alo 153'ü ara. Uyarın mahalledeki besleyicilere görünür.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil bir durum varsa önce 112'yi veya Alo 153'ü ara. Uyarın mahalledeki besleyicilere görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In an emergency, call 112 or Alo 153 first. Your alert is shown to feeders in the neighborhood."
          }
        }
      }
