    "Yakındaki bildirimleri açarsan yalnızca son yaklaşık konumun tutulur; her güncellemede üzerine yazılır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki bildirimleri açarsan yalnızca son yaklaşık konumun tutulur; her güncellemede üzerine yazılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn on nearby notifications, only your last approximate location is kept; it's overwritten with every update."
          }
        }
      }
    },
    "Yakındaki gönüllülere haber vereceğiz. Biri mama koyunca bildirim kapanır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki gönüllülere haber vereceğiz. Biri mama koyunca bildirim kapanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let nearby volunteers know. The alert closes when someone puts out food."
          }
        }
      }
    },
    "Yakındaki noktaları göstermek ve 'Mama koydum' dediğinde noktanın yanında olduğunu doğrulamak için. Konum geçmişini saklamayız.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki noktaları göstermek ve 'Mama koydum' dediğinde noktanın yanında olduğunu doğrulamak için. Konum geçmişini saklamayız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show nearby spots and to verify you're at the spot when you tap \"I fed them\". We don't store location history."
          }
        }
      }
    },
    "Yakındaki noktaları göstermek, \"mama gerekli\" haberlerini iletmek.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki noktaları göstermek, \"mama gerekli\" haberlerini iletmek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show nearby spots and deliver \"food needed\" alerts."
          }
        }
      }
    },
