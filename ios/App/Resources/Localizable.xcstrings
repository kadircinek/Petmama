    "Yakınında henüz kayıtlı bir besleme noktası yok.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınında henüz kayıtlı bir besleme noktası yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no registered feeding spot near you yet."
          }
