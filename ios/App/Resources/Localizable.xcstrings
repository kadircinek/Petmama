    "Mama Haritası tıbbi tavsiye vermez. Hayvanın durumu için bir veterinere danış.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mama Haritası tıbbi tavsiye vermez. Hayvanın durumu için bir veterinere danış."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mama Haritası does not give medical advice. Consult a vet about an animal's condition."
          }
        }
      }
    },
    "Mama Haritası tıbbi tavsiye vermez. Paylaştıktan sonra en yakın veteriner kliniklerini göstereceğiz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mama Haritası tıbbi tavsiye vermez. Paylaştıktan sonra en yakın veteriner kliniklerini göstereceğiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mama Haritası does not give medical advice. After you share, we'll show you the nearest vet clinics."
          }
        }
      }
    },
    "Mama Haritası'nı kullanırken kişisel verilerini 6698 sayılı Kişisel Verilerin Korunması Kanunu (KVKK) kapsamında nasıl işlediğimizi kısaca anlatıyoruz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mama Haritası'nı kullanırken kişisel verilerini 6698 sayılı Kişisel Verilerin Korunması Kanunu (KVKK) kapsamında nasıl işlediğimizi kısaca anlatıyoruz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short explanation of how we process your personal data when you use Mama Haritası, under Law No. 6698 on the Protection of Personal Data (KVKK, Turkish data protection law)."
