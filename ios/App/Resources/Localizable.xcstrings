    "Sokak hayvanları için belediyenin veteriner birimine Beyaz Masa üzerinden ulaşabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sokak hayvanları için belediyenin veteriner birimine Beyaz Masa üzerinden ulaşabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For street animals, you can reach the municipality's veterinary unit through Beyaz Masa."
          }
